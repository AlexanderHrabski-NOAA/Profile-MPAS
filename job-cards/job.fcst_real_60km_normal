#! /bin/sh
#SBATCH --account=fv3-cpu
#SBATCH --qos=batch
#SBATCH --nodes=8
#SBATCH --tasks-per-node=96
#SBATCH --cpus-per-task=1
#SBATCH -t 00:30:00
#SBATCH --exclusive
#SBATCH --job-name=fcst_norm
#SBATCH -o out.fcst_norm
#SBATCH -e err.fcst_norm

MACHINE_ID=ursa
source ./module-setup.sh
module purge
module use $PWD/modulefiles
module load mpas/ursa
module list

export I_MPI_COLL_INTRANODE=shmem
export I_MPI_PIN=1

export OMP_STACKSIZE=2G
export OMP_PROC_BIND=close
export OMP_PLACES=cores

srun -N 8 --tasks-per-node=96 --cpus-per-task=1 /scratch3/NCEPDEV/global/${USER}/MPAS/MPAS-Model/build/bin/mpas_atmosphere
