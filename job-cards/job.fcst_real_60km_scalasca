#! /bin/sh
#SBATCH --account=fv3-cpu
#SBATCH --qos=batch
#SBATCH --nodes=4
#SBATCH --tasks-per-node=96
#SBATCH --cpus-per-task=1
#SBATCH -t 00:40:00
#SBATCH --exclusive
#SBATCH --job-name=fcst_prof
#SBATCH -o out.fcst_prof
#SBATCH -e err.fcst_prof

MACHINE_ID=ursa
source ./module-setup.sh
module purge
module use $PWD/modulefiles
module load mpas/ursa
module list

export I_MPI_COLL_INTRANODE=shmem
export I_MPI_PIN=1

export OMP_STACKSIZE=2G
export OMP_PROC_BIND=close
export OMP_PLACES=cores

ulimit -s unlimited
export SCOREP_PAGE_SIZE=64k
export SCOREP_FILTERING_FILE=scorep.filt
export SCOREP_TOTAL_MEMORY=4G

unset SLURM_MEM_PER_CPU SLURM_MEM_PER_GPU SLURM_MEM_PER_NODE

export SCOREP_TOTAL_MEMORY=4095M

scalasca --analyze srun -N 4 --tasks-per-node=96 --cpus-per-task=1 /scratch3/NCEPDEV/global/${USER}/MPAS/MPAS-Model/build/bin/mpas_atmosphere
